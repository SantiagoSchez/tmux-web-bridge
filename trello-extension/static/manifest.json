{
  "manifest_version": 3,
  "name": "Trello → twb",
  "version": "0.0.0",
  "description": "Lanza un Claude en tmux-web-bridge con una tarjeta de Trello y la mueve a Doing.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.trello.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://trello.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Trello → twb: opciones" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
