{
  "name": "trello-extension",
  "private": true,
  "type": "module",
  "description": "Chrome extension: launch a Claude Code task on a Trello card through twb",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
