# Servicio de usuario de systemd para el servidor central de tmux-web-bridge.
# Lo instala deploy/install-hub.sh en ~/.config/systemd/user/ (con @APP_DIR@ y @NODE@ resueltos).
[Unit]
Description=tmux-web-bridge (panel web de tmux para la tailnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
Environment=TMUX_WEB_CONFIG=@APP_DIR@/config.yaml
Environment=NODE_ENV=production
ExecStart=@NODE@ @APP_DIR@/server/dist/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
