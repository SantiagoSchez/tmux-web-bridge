# Aviso al servidor central de tmux-web-bridge desde tmux-window-title.sh.
# Se instala en ~/.config/tmux-web-bridge/notify.env (permisos 600).

# URL del panel (la que abres en el navegador).
HUB_URL=https://twb.example.com

# Id de esta máquina, igual que en el config.yaml del servidor central.
HOST_ID=mac

# El notifyToken del config.yaml del servidor central.
NOTIFY_TOKEN=cambia-esto

# Solo macOS: no avisar al móvil si has usado el teclado o el ratón del Mac en
# los últimos N segundos (ya te llega la notificación del Mac). 0 = avisar siempre.
PUSH_MIN_IDLE=60
